# Example: /etc/nginx/sites-available/simapi.nice-ai.dev
#
# 1) Replace domain and cert paths with your real values.
# 2) Keep backend bound to 127.0.0.1:8765 only.

limit_req_zone $binary_remote_addr zone=simapi_limit:10m rate=20r/s;

server {
    listen 80;
    listen [::]:80;
    server_name simapi.nice-ai.dev;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name simapi.nice-ai.dev;

    ssl_certificate /etc/letsencrypt/live/simapi.nice-ai.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/simapi.nice-ai.dev/privkey.pem;

    client_max_body_size 2m;
    keepalive_timeout 65;

    # TODO: Replace with your real frontend origins
    add_header Access-Control-Allow-Origin "https://nice-ai.dev" always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key" always;

    if ($request_method = OPTIONS) {
        return 204;
    }

    location / {
        limit_req zone=simapi_limit burst=30 nodelay;
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

