# 复制到 VPS：/etc/default/ss-biomass-api
#   sudo cp deploy/env.example /etc/default/ss-biomass-api
#   sudo chmod 600 /etc/default/ss-biomass-api
#
# 首次部署时 deploy/deploy.sh 会在文件不存在时自动生成 SIM_API_KEY。
#
# certbot 联系邮箱（可覆盖）：
# CERTBOT_EMAIL=dachou5224@gmail.com

# 非空则 POST 必须携带 Header: X-API-Key
SIM_API_KEY=

# CORS 白名单（逗号分隔，无空格）。生产勿使用 *
SIM_API_ALLOWED_ORIGINS=https://nice-ai.dev,https://www.nice-ai.dev
